# Deep Research Lab - Environment Variables
# Copy this file to .env and fill in your API keys
# NEVER commit .env to git!

# =============================================================================
# LLM APIs (Required - at least one)
# =============================================================================

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Google Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza-your-gemini-key-here

# =============================================================================
# Research/Search APIs (Recommended)
# =============================================================================

# Semantic Scholar - https://www.semanticscholar.org/product/api
# Free tier: 100 requests/5 min without key, higher limits with key
SEMANTIC_SCHOLAR_API_KEY=

# Exa - https://exa.ai
# Free tier: 1000 searches/month
EXA_API_KEY=

# OpenAlex - https://openalex.org
# Free, no key needed - just set your email for polite pool
OPENALEX_EMAIL=your-email@example.com

# =============================================================================
# Optional APIs
# =============================================================================

# Tavily (legacy, optional) - https://tavily.com
# Free tier: 1000 searches/month
TAVILY_API_KEY=

# Unpaywall - https://unpaywall.org/products/api
# Free, just needs email
UNPAYWALL_EMAIL=your-email@example.com

# =============================================================================
# Email Notifications (Optional)
# =============================================================================

# SMTP settings for email notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFICATION_RECIPIENT=recipient@example.com
EMAIL_NOTIFICATIONS_ENABLED=false
