{
  "enabled": true,
  "name": "Dependency Tracker",
  "description": "Detect new imports that may need to be added to requirements.txt",
  "version": "1",
  "when": {
    "type": "onFileSave",
    "patterns": ["backend/**/*.py", "api/**/*.py", "scripts/**/*.py"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Check if the saved file has any new third-party imports that aren't in requirements.txt:\n1. Extract import statements from the file\n2. Filter to third-party packages (not stdlib, not local modules)\n3. Compare against requirements.txt\n\nOnly report if there are NEW imports not in requirements.txt. Ignore stdlib modules (os, sys, json, asyncio, etc.) and local imports (backend.*, api.*). Be concise - just list the missing packages."
  }
}
