{
  "enabled": true,
  "name": "Python Format & Lint",
  "description": "Auto-format and lint Python files with ruff on save",
  "version": "2",
  "when": {
    "type": "onFileSave",
    "patterns": ["backend/**/*.py", "api/**/*.py", "scripts/**/*.py", "tests/**/*.py"]
  },
  "then": {
    "type": "runCommand",
    "command": "ruff format ${file} && ruff check ${file} --fix --output-format=concise"
  }
}
