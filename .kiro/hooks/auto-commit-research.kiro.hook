{
  "enabled": false,
  "name": "Auto-Commit Research Runs",
  "description": "Automatically commit research run output files when a run completes. Disabled by default - enable in settings if you want to track research outputs in git.",
  "version": "1",
  "when": {
    "type": "onFileChange",
    "patterns": ["neura_lab_runs/**/*.json", "neura_lab_runs/**/*.md"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A research run has completed and output files were created/modified in neura_lab_runs/.\n\n1. Check for new/modified files in neura_lab_runs/ with: git status --porcelain --ignored neura_lab_runs/\n2. If there are changes (look for lines starting with '??' or '!!'):\n   a. Look at the changed files to determine the component name from the directory structure (e.g., neura_lab_runs/components/{component_name}/)\n   b. Check if the run completed successfully by looking for cycle_result.json or node_result.json files\n   c. Force-stage the neura_lab_runs/ changes (even if gitignored): git add -f neura_lab_runs/\n   d. Create a commit with message format: \"research: {component} - {status}\"\n      - {component} should be the research component name extracted from the path\n      - {status} should be 'completed' for successful runs (has result files) or 'partial' for incomplete runs\n   e. Report what was committed\n3. If no changes in neura_lab_runs/, say nothing."
  }
}
