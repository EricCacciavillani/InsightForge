{
  "enabled": true,
  "name": "Security Scan",
  "description": "Scan for hardcoded secrets and security vulnerabilities on file save",
  "version": "4",
  "when": {
    "type": "onFileSave",
    "patterns": [
      "backend/**/*.py",
      "api/**/*.py",
      "scripts/**/*.py",
      "frontend/src/**/*.ts",
      "frontend/src/**/*.tsx",
      "frontend/electron/**/*.js",
      "*.env*"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Security scan this file. Check for:\n1. CRITICAL: Hardcoded API keys/secrets (sk-*, AIza*, tvly-*, ghp_*, etc.) - BLOCK and alert\n2. WARNING: SQL/command injection, unsafe eval(), XSS vulnerabilities - report with line numbers\n3. INFO: HTTP instead of HTTPS - note only\n\nFor each issue found: severity, line number, fix suggestion. Secrets should use os.environ (Python) or process.env (JS/TS). Only report if issues found, otherwise stay silent."
  }
}
